* text=auto eol=lf

*.cs text diff=csharp
*.java text diff=java
*.kt text
*.kts text
*.json text
*.yaml text
*.yml text
*.md text
*.csv text
*.py text
*.ps1 text
*.sh text eol=lf
# Unity YAML serializes empty scalar values as `key: `, so do not treat the
# generated trailing space as a whitespace error.
*.unity text whitespace=-blank-at-eol
*.prefab text whitespace=-blank-at-eol
*.asset text whitespace=-blank-at-eol
*.meta text whitespace=-blank-at-eol

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.psd binary
*.aseprite binary

