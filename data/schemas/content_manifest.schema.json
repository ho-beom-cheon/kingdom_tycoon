{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentManifest",
  "type": "object",
  "required": [
    "contentVersion",
    "tables",
    "generatedAtUtc"
  ],
  "properties": {
    "contentVersion": {
      "type": "string"
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}