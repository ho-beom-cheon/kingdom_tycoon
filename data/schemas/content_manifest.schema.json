{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tycoon:schema:content-manifest:v1",
  "title": "Kingdom Tycoon Canonical Content Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "contractVersion",
    "contentVersion",
    "generatedAtUtc",
    "tables"
  ],
  "properties": {
    "schemaId": {
      "const": "urn:tycoon:content-manifest:v1"
    },
    "contractVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "rowCount",
        "primaryKey",
        "fields",
        "foreignKeys"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.csv$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "primaryKey": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "foreignKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foreignKey"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain",
        "nullable",
        "enumValues"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "domain": {
          "enum": [
            "STRING",
            "STABLE_ID",
            "BOOL",
            "INT32",
            "SAFE_INT",
            "DECIMAL",
            "UTC_INSTANT",
            "STATUS",
            "ENUM"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "enumValues": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "targetFile",
        "targetFields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "targetFile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.csv$"
        },
        "targetFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
