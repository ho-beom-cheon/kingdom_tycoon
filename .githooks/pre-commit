#!/usr/bin/env bash
set -Eeuo pipefail

hook_name="pre-commit"
pipeline_started=$SECONDS
step_started=$SECONDS
current_step="initialization"

fail() {
  local message="$1"
  printf '\n[%s] FAILED at "%s" after %ss: %s\n' \
    "$hook_name" "$current_step" "$((SECONDS - pipeline_started))" "$message" >&2
  exit 1
}

handle_error() {
  local exit_code=$?
  printf '\n[%s] FAILED at "%s" after %ss (exit code %s).\n' \
    "$hook_name" "$current_step" "$((SECONDS - pipeline_started))" "$exit_code" >&2
  exit "$exit_code"
}

start_step() {
  local number="$1"
  local total="$2"
  local description="$3"
  current_step="$description"
  step_started=$SECONDS
  printf '\n[%s %s/%s] %s...\n' "$hook_name" "$number" "$total" "$description"
}

finish_step() {
  printf '[%s] OK: %s (%ss)\n' \
    "$hook_name" "$current_step" "$((SECONDS - step_started))"
}

trap handle_error ERR

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

branch_name="$(git branch --show-current)"
if [ -z "$branch_name" ]; then
  branch_name="detached HEAD"
fi

mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR)
printf '[%s] Pipeline started (branch: %s, staged files: %s).\n' \
  "$hook_name" "$branch_name" "${#staged_files[@]}"

start_step 1 3 "Validate content data"
validator="scripts/validate_content.py"
canonical_generator="scripts/generate_canonical_content.py"
p04_generator="scripts/generate_p04_content.py"
p05_generator="scripts/generate_p05_content.py"
p06_generator="scripts/generate_p06_content.py"
[ -f "$validator" ] || fail "Tracked content validator not found: ${validator}"
[ -f "$canonical_generator" ] || fail "Canonical content generator not found: ${canonical_generator}"
[ -f "$p04_generator" ] || fail "P04 content generator not found: ${p04_generator}"
[ -f "$p05_generator" ] || fail "P05 content generator not found: ${p05_generator}"
[ -f "$p06_generator" ] || fail "P06 content generator not found: ${p06_generator}"
command -v python >/dev/null 2>&1 || fail "Python is not available on PATH."
printf '[%s] Canonical package: %s --check\n' "$hook_name" "$canonical_generator"
PYTHONUNBUFFERED=1 python -u "$canonical_generator" --check
printf '[%s] P04 package: %s --check\n' "$hook_name" "$p04_generator"
PYTHONUNBUFFERED=1 python -u "$p04_generator" --check
printf '[%s] P05 package: %s --check\n' "$hook_name" "$p05_generator"
PYTHONUNBUFFERED=1 python -u "$p05_generator" --check
printf '[%s] P06 package: %s --check\n' "$hook_name" "$p06_generator"
PYTHONUNBUFFERED=1 python -u "$p06_generator" --check
printf '[%s] Validator: %s\n' "$hook_name" "$validator"
PYTHONUNBUFFERED=1 python -u "$validator"
finish_step

is_forbidden_path() {
  local file="$1"

  case "$file" in
    Library/*|*/Library/*|Temp/*|*/Temp/*|Logs/*|*/Logs/*|Build/*|*/Build/*|Builds/*|*/Builds/*)
      return 0
      ;;
    .idea/*|*/.idea/*|.vscode/*|*/.vscode/*|.vs/*|*/.vs/*)
      return 0
      ;;
    *.jks|*.keystore|service-account*.json|*/service-account*.json)
      return 0
      ;;
    .env|*/.env|.env.*|*/.env.*)
      case "$file" in
        .env.example|*/.env.example)
          return 1
          ;;
      esac
      return 0
      ;;
  esac

  return 1
}

start_step 2 3 "Check forbidden staged paths"
for file in "${staged_files[@]}"; do
  if is_forbidden_path "$file"; then
    fail "Forbidden staged file: $file"
  fi
done
finish_step

start_step 3 3 "Check Unity Asset meta files"
unity_asset_count=0
for file in "${staged_files[@]}"; do
  case "$file" in
    *.meta)
      continue
      ;;
  esac

  if [[ "$file" == client-unity/Assets/* ]] && [ -f "$file" ]; then
    unity_asset_count=$((unity_asset_count + 1))
    [ -f "${file}.meta" ] || fail "Missing Unity meta file: ${file}.meta"
  fi
done
printf '[%s] Unity Assets checked: %s\n' "$hook_name" "$unity_asset_count"
finish_step

printf '\n[%s] Pipeline passed in %ss.\n' \
  "$hook_name" "$((SECONDS - pipeline_started))"
